# ==================== DATABASE ====================
DATABASE_URL=postgresql://postgres:change-me-strong@postgres:5432/appdb?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=appdb

# ==================== REDIS ====================
REDIS_URL=redis://redis:6379

# ==================== JWT ====================
JWT_SECRET=change-me-32chars-minimum-secret

# ==================== MINIO ====================
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me-strong
MINIO_BUCKET=product-images

# ==================== KAFKA ====================
KAFKA_BROKER=kafka:9092

# Topics
KAFKA_TOPIC_ORDERS=wine-orders
KAFKA_TOPIC_PAYMENTS=payment-events
